{
  "functions": {
    "api/index.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/us_open_scheduler_edt",
      "destination": "/api?slot=edt"
    },
    {
      "source": "/api/us_open_scheduler_est",
      "destination": "/api?slot=est"
    }
  ],
  "crons": [
    {
      "path": "/api/us_open_scheduler_edt",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/us_open_scheduler_est",
      "schedule": "0 13 * * 1-5"
    }
  ]
}
