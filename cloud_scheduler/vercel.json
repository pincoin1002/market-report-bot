{
  "functions": { "api/index.mjs": { "maxDuration": 30 } },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "rewrites": [
    { "source": "/api/tw_open_scheduler", "destination": "/api?slot=tw_open" },
    { "source": "/api/tw_close_scheduler", "destination": "/api?slot=tw_close" },
    { "source": "/api/us_open_scheduler_edt", "destination": "/api?slot=edt" },
    { "source": "/api/us_open_scheduler_est", "destination": "/api?slot=est" },
    { "source": "/api/us_close_scheduler", "destination": "/api?slot=us_close" }
  ],
  "crons": [
    { "path": "/api/tw_open_scheduler", "schedule": "40 23 * * 0-4" },
    { "path": "/api/tw_close_scheduler", "schedule": "5 7 * * 1-5" },
    { "path": "/api/us_open_scheduler_edt", "schedule": "5 13 * * 1-5" },
    { "path": "/api/us_open_scheduler_est", "schedule": "5 14 * * 1-5" },
    { "path": "/api/us_close_scheduler", "schedule": "30 0 * * 2-6" }
  ]
}
